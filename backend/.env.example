# ============================================
# RESTREN SYSTEM - Environment Variables
# Copy this to .env and fill in your values
# ============================================

# Server
PORT=5000
NODE_ENV=development
FRONTEND_URL="http://localhost:5173"

# ============================================
# DATABASE (Aiven MySQL)
# Replace with your Aiven connection string
# Format: mysql://USER:PASSWORD@HOST:PORT/DB?ssl-mode=REQUIRED
# ============================================
DATABASE_URL="mysql://root:password@localhost:3306/restren_db"

# ============================================
# JWT Authentication
# Use a long random string in production!
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# ============================================
JWT_SECRET="super_secret_enterprise_jwt_key_2026_ethiopia_change_in_prod"
JWT_EXPIRES_IN="7d"

# ============================================
# REDIS (Optional - for rate limiting & cache)
# Local: redis://localhost:6379
# Cloud: Use Aiven Redis or Upstash
# ============================================
REDIS_URL="redis://localhost:6379"

# ============================================
# CLOUDINARY (Image Storage)
# Get from: https://cloudinary.com/console
# ============================================
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# ============================================
# EMAIL (Nodemailer - SMTP)
# For Gmail: Enable App Passwords
# ============================================
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your_email@gmail.com"
SMTP_PASS="your_app_password"

# ============================================
# CORS
# ============================================
CORS_ORIGIN="http://localhost:5173"

# ============================================
# SENTRY (Error Monitoring)
# Get from: https://sentry.io
# ============================================
SENTRY_DSN=""
